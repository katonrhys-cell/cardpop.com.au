# Caddy in front of the CardPop app container — docs/vultr-rollout.md.
#
# Cloudflare proxies cardpop.com.au and connects to this box over HTTPS in
# "Full (strict)" mode, so Caddy presents a Cloudflare Origin CA certificate
# (free, 15 years, trusted by Cloudflare's edge only) instead of asking Let's
# Encrypt — ACME can't complete behind the proxy anyway. Put the pair at
# deploy/certs/origin.pem + deploy/certs/origin.key (git-ignored).

{
	admin off
	# Keep the X-Forwarded-For chain Cloudflare sends and APPEND the connecting
	# peer to it, whoever that is. This is deliberately "trust every peer":
	# Caddy's job is to preserve the chain, and the Node server validates it
	# (src/app.js `trust proxy`: Caddy is one trusted hop, then only Cloudflare
	# edge addresses are walked past). A request that reaches the origin
	# without going through Cloudflare has its own address appended behind
	# whatever it forged, and req.ip resolves to that address — so the
	# forgery fails exactly as it does today. One list of Cloudflare ranges
	# (cloudflareIps.js) stays the single source of truth; the firewall is
	# what keeps non-Cloudflare traffic out in the first place.
	servers {
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

cardpop.com.au, www.cardpop.com.au {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

	encode zstd gzip

	reverse_proxy app:3000 {
		# The grade estimator streams SSE for up to a minute; never buffer it.
		flush_interval -1
		# Long-running cron functions (event scan, blog generation) may hold a
		# request for several minutes. Cloudflare itself gives up at 100 s —
		# see the runbook for the direct-origin hostname that avoids that.
		transport http {
			response_header_timeout 330s
		}
	}

	log {
		output stdout
		format json
	}
}

# Cloudflare only ever reaches the origin over HTTPS in Full (strict) mode;
# anything on :80 is a stray and is sent to HTTPS.
:80 {
	redir https://{host}{uri} 308
}
