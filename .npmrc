# Fail fast on an unsupported Node version instead of installing anyway and
# breaking at runtime with a confusing error. `engines.node` in package.json is
# ">=22" (the app is tested on 22 and 24; 24 is the preferred version pinned in
# .nvmrc / CI / Vercel), so this blocks genuinely-too-old Node (18, 20) with a
# clear message rather than a silent, mysterious failure later.
engine-strict=true

# New dependencies added with `npm install <pkg>` are pinned to an exact version
# (no ^caret range), so a fresh install can't quietly pull a newer, untested
# minor/patch. Existing ranges are unchanged; the committed package-lock.json
# remains the source of truth for reproducible installs (`npm ci`).
save-exact=true
