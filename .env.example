# Supabase
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# eBay Developer API Credentials
# Register at https://developer.ebay.com to get your App ID and Client Secret
EBAY_APP_ID=your-app-id-here
EBAY_CLIENT_SECRET=your-client-secret-here

# Optional: override the eBay API base URL (defaults to production)
# Set to https://api.sandbox.ebay.com for sandbox testing
# EBAY_API_URL=https://api.ebay.com

# Optional: eBay marketplace ID (defaults to EBAY_AU)
# EBAY_MARKETPLACE_ID=EBAY_AU

# Optional: Cache TTL in seconds for popular-cards endpoint (defaults to 3600 = 1 hour)
# EBAY_CACHE_TTL=3600
