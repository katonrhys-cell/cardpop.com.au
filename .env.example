# ─────────────────────────────────────────────────────────────────────────────
# CardPop Australia — Environment Variables Reference
# Copy this file to .env and fill in the secret values.
# Public values are pre-filled. Secret values are marked <REQUIRED>.
#
# WHERE EACH VARIABLE IS NEEDED:
#   [build]   → GitHub Actions secret (injected at build time by Vite)
#   [server]  → Hostinger Node.js environment variables (runtime, backend)
#   [both]    → needed in both places
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase [both] ──────────────────────────────────────────────────────────
# Project URL — not secret, safe to commit
VITE_SUPABASE_URL=https://odoglvswwymyjuwlonkf.supabase.co
SUPABASE_URL=https://odoglvswwymyjuwlonkf.supabase.co

# Anon (public) key — not secret, safe to commit
# Get from: Supabase dashboard → Settings → API → Project API keys → anon/public
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im9kb2dsdnN3d3lteWp1d2xvbmtmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzg3OTQ5NTgsImV4cCI6MjA5NDM3MDk1OH0.R5fwR42iKIEsfx1iA-fjk4YPLCH3mcmoIKkosEy6g1I

# Service role key — SECRET, never commit. Required for backend admin operations.
# Get from: Supabase dashboard → Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=<REQUIRED>

# ── Stripe [server] ───────────────────────────────────────────────────────────
# Get from: Stripe dashboard → Developers → API keys
# Use sk_test_… / a test-mode webhook secret in dev, sk_live_… in production.
STRIPE_SECRET_KEY=<REQUIRED>
STRIPE_WEBHOOK_SECRET=<REQUIRED>
# Subscription (membership) price — Stripe dashboard → Products → your plan → Price ID.
# Required for the /subscription Stripe checkout; endpoint returns 503 if unset.
# STRIPE_SUBSCRIPTION_PRICE_ID=price_...
# Optional Stripe Identity verification flow (signup ID checks). Falls back to an
# inline document+selfie config if unset. Stripe dashboard → Identity → Verification flows.
# STRIPE_IDENTITY_FLOW_ID=vf_...

# ── PayPal [server] ───────────────────────────────────────────────────────────
# Currently used for membership subscriptions (src/utils/paypalClient.js). If any
# are unset, PayPal subscription endpoints report "not configured" (fail-safe).
# Get from: developer.paypal.com → Apps & Credentials (pick Sandbox or Live).
# PAYPAL_ENV switches the API base: 'sandbox' (default) or 'live'.
# PAYPAL_ENV=sandbox
# PAYPAL_CLIENT_ID=<REQUIRED for PayPal>
# PAYPAL_CLIENT_SECRET=<REQUIRED for PayPal>
# Subscription plan id — developer.paypal.com → Billing plans (or via API).
# PAYPAL_SUBSCRIPTION_PLAN_ID=P-...
# Webhook id — developer.paypal.com → your app → Webhooks (used to verify signatures).
# PAYPAL_WEBHOOK_ID=<REQUIRED for PayPal webhooks>

# ── CardSight AI [server] ────────────────────────────────────────────────────
# Get from: app.cardsight.ai → API Keys
# Used for: card image identification (vault)
CARDSIGHT_API_KEY=<REQUIRED>

# ── Anthropic API [server] ───────────────────────────────────────────────────
# Get from: console.anthropic.com → API keys
# Used for: card OCR / field extraction from card photos
ANTHROPIC_API_KEY=<REQUIRED>

# ── eBay Developer API [server] ───────────────────────────────────────────────
# Get from: developer.ebay.com → My Account → Application Keys
EBAY_APP_ID=<REQUIRED>
EBAY_CLIENT_SECRET=<REQUIRED>
# Optional overrides (defaults shown):
# EBAY_API_URL=https://api.ebay.com
# EBAY_MARKETPLACE_ID=EBAY_AU
# EBAY_CACHE_TTL=3600

# ── PSA Public API [server] ───────────────────────────────────────────────────
# Get from: PSA Public API dashboard (psacard.com → account → API tokens)
# Used for: certificate verification on listings (src/utils/psaApiClient.js).
# Unset = every cert shows "Verification error" — /grading-verification/verify
# has no non-API fallback. Effectively required in production.
PSA_API_TOKEN=<REQUIRED>

# ── FTP Deploy [GitHub Actions secrets only] ─────────────────────────────────
# Used by .github/workflows/deploy.yml — set as GitHub repo secrets, not here
# FTP_SERVER=<your-hostinger-ftp-host>
# FTP_USERNAME=<your-ftp-username>
# FTP_PASSWORD=<your-ftp-password>

# ── App [server] ─────────────────────────────────────────────────────────────
APP_URL=https://cardpop.com.au
# Pre-launch mode [build]: 'true' redirects the homepage to the /launch
# email-capture landing page (deep links keep working). Unset/false = normal.
# VITE_COMING_SOON=true
CORS_ORIGIN=https://cardpop.com.au
PORT=3001
# Number of front proxies to trust for X-Forwarded-For (req.ip). Vercel = 1.
# Increase only if additional reverse proxies sit in front of the app.
# TRUST_PROXY_HOPS=1

# ── Kit.com (ConvertKit) [server] ────────────────────────────────────────────
# Get from: kit.com → Settings → Developer → API Keys
# API key (secret — never commit): Settings → Developer → API Keys → Create API Key
KIT_API_KEY=<REQUIRED>
# Form ID: kit.com → Forms → pick a form → copy the numeric ID from the URL
KIT_FORM_ID=<REQUIRED>
# Pre-launch notify list form ID (used by the /launch landing page).
# Optional — signups fall back to KIT_FORM_ID until this is set.
# KIT_LAUNCH_FORM_ID=

# ── Resend (transactional email) [server] ────────────────────────────────────
# Sends the automated, server-triggered emails: order confirmations, sale
# notifications, refund notices and the registration welcome offer
# (src/utils/emailService.js). This is separate from Google Workspace (human
# inbox) and Kit.com (bulk marketing) — see docs/email.md.
# Get from: resend.com → API Keys → Create API Key
# The sending domain (cardpop.com.au) must be VERIFIED in Resend first — add its
# SPF/DKIM records in Cloudflare DNS (docs/email.md). If this key is unset the
# service logs a warning and silently skips sending (fail-safe).
RESEND_API_KEY=<REQUIRED>
# Pre-launch welcome email PDF attachment (the early-access guide). Optional.
# Set to a publicly reachable PDF URL (e.g. a Supabase Storage public URL) and
# Resend attaches it. If unset, the backend falls back to a committed file at
# src/emails/assets/launch-welcome.pdf; if neither exists the welcome email
# still sends, just without the attachment. See src/emails/assets/README.md.
# LAUNCH_WELCOME_PDF_URL=

# ── Amazon Location Service (address autocomplete + validation) [both] ───────
# Powers the checkout shipping form: the Street Address field autocompletes
# against Amazon Location's Places API (real AU addresses only), and the backend
# re-checks the chosen address with the geocode API before creating the Stripe
# session so a bypassed frontend can't push a fake address through.
#
# Create an API key in the AWS console → Amazon Location Service → API keys,
# scoped to the Places resource (geocode / autocomplete / get-place). The
# standalone Places endpoint accepts the key as a `?key=` query param, so no AWS
# access-key / SigV4 signing is needed.
#
# Region for the places.geo.<region>.amazonaws.com host. Defaults to
# ap-southeast-2 (Sydney) if unset.
AWS_LOCATION_REGION=ap-southeast-2
VITE_AWS_LOCATION_REGION=ap-southeast-2
#
# Public key — exposed in the browser. [build]
# In the AWS console, restrict this key to your referrer origins (cardpop.com.au,
# localhost) and to the autocomplete / get-place actions. If left blank the
# shipping form falls back to plain free-text inputs (no client-side gate).
VITE_AWS_LOCATION_API_KEY=
# Server key — used by the backend geocode validation call. [server]
# May be the same key or a separate server-scoped key (geocode action). If unset
# the backend skips validation (fail-open) so local dev keeps working.
AWS_LOCATION_API_KEY=

# ── Google reCAPTCHA v2 [both] ───────────────────────────────────────────────
# Protects the signup, login and newsletter forms from bots.
# Register a "reCAPTCHA v2 — I'm not a robot Checkbox" site at:
#   https://www.google.com/recaptcha/admin
# Add your domain(s) (e.g. cardpop.online, localhost) and copy the two keys.
#
# Site key — public, safe to commit / expose in the browser. [build]
# If left blank the reCAPTCHA widgets are hidden and the forms work without them.
VITE_RECAPTCHA_SITE_KEY=
# Secret key — SECRET, never commit. The backend uses it to verify tokens. [server]
# If unset, the backend skips verification (fail-open) so local dev keeps working.
RECAPTCHA_SECRET_KEY=<REQUIRED>

# ── Cloudflare Turnstile [build + Supabase dashboard] ────────────────────────
# Protects the Supabase Auth flows (signup, login, password reset, resend) via
# Supabase's native CAPTCHA. Create a widget at:
#   https://dash.cloudflare.com → Turnstile → Add site
#
# Site key — public, safe to commit / expose in the browser. [build]
# If left blank the Turnstile widgets are hidden and the auth forms work as before.
VITE_TURNSTILE_SITE_KEY=
#
# Turnstile SECRET key — do NOT put it here. Paste it into Supabase:
#   Supabase dashboard → Authentication → Attack Protection → enable CAPTCHA →
#   provider "Turnstile" → paste the secret → Save.
# Enable both sides together: turning CAPTCHA on in Supabase while the site key
# above is missing from the build will reject every auth request.

# ── Optional / advanced [server] ─────────────────────────────────────────────
# Used to encrypt MFA OTPs and backup codes — set a strong random value
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=<REQUIRED>
# SESSION_TIMEOUT_MS=1800000
# LOGIN_ATTEMPT_MAX_TRIES=5
# LOGIN_ATTEMPT_LOCK_DURATION_MS=900000
#
# Cron secret for the daily price-refresh endpoint (/prices/refresh). Vercel Cron
# sends "Authorization: Bearer <CRON_SECRET>" automatically when this is set. Set
# it in production so the full-refresh endpoint isn't callable anonymously.
# CRON_SECRET=<strong-random-value>
#
# Image CDN host (Cloudflare Worker on img.cardpop.com.au). When set, frontend
# image URLs [build] and og:image URLs [server] are rewritten onto the CDN to
# cut Supabase egress. See docs/image-cdn.md.
# VITE_IMAGE_CDN_HOST=img.cardpop.com.au
# IMAGE_CDN_HOST=img.cardpop.com.au
