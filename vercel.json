{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 40,
      "includeFiles": "node_modules/@img/**"
    },
    "api/sitemap.js": {
      "maxDuration": 10
    },
    "api/prerender.js": {
      "maxDuration": 10
    },
    "api/blog-generate.js": {
      "maxDuration": 300
    },
    "api/event-scan.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/prices/refresh",
      "schedule": "30 19 * * *"
    },
    {
      "path": "/cron/blog-generate",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/cron/event-scan",
      "schedule": "0 17 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.cardpop.com.au"
        }
      ],
      "destination": "https://cardpop.com.au/:path*",
      "permanent": true
    },
    {
      "source": "/product/marketplace/:id/:slug*",
      "destination": "/marketplace/:id/:slug*",
      "permanent": true
    },
    {
      "source": "/product/marketplace/:id",
      "destination": "/marketplace/:id",
      "permanent": true
    },
    {
      "source": "/community/events",
      "destination": "/events",
      "permanent": true
    },
    {
      "source": "/community/events/:slug*",
      "destination": "/events/:slug*",
      "permanent": true
    }
  ],
  "rewrites": [
